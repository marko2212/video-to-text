# Keep the build context small and the image clean.
.git
.github
.claude
.venv
__pycache__
**/__pycache__
*.pyc
.ruff_cache
.pytest_cache

# Secrets and runtime data (never bake into the image)
.env
temp
uploads
models
data

# The image runs on its own Python (FROM python:3.12-slim); the repo's pin
# must not send uv off to fetch another one inside the container.
.python-version

# Not needed at runtime
docs
tests
scripts
assets
*.md
Dockerfile
docker-compose.yml
.dockerignore
