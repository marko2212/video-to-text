# .env.example

# OpenAI API Key — needed for the OpenAI engine and for on-screen context.
# The local offline engine works without it.
OPENAI_API_KEY=<your_openai_api_key_here>

# --- Optional overrides -----------------------------------------------------

# Device for the local Whisper engine: cpu (default) or cuda.
# LOCAL_DEVICE=cpu

# Where downloaded local Whisper models are cached.
# WHISPER_MODEL_DIR=models

# Hard cap on screenshots described per video (on-screen context).
# Raising it costs mostly time: frames are described one request at a time.
# FRAME_MAX_COUNT=200

# Length of each audio chunk sent to OpenAI, for every model (1-15 minutes).
# Unset: 5 for gpt-4o-transcribe (its answers stop at ~2,000 tokens, which
# dense speech reaches in 10 minutes) and 10 for whisper-1.
# SEGMENT_DURATION_MINUTES=5

# Rewrite Serbian Cyrillic in transcripts as Latin script. Off by default: the
# script the model returned is kept (it may alternate between chunks). Leave it
# off for Macedonian, which it would rewrite in Serbian Latin.
# SERBIAN_LATIN=true
